# Preserve the existing font files and fallback rules, including Unifont and
# Loma, rather than substituting font families during the runtime migration.
# Only font data and fontconfig XML cross this stage; no Debian ELF files do.
FROM node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0 AS fonts
RUN set -eux; \
    apt-get -qq update; \
    apt-get -qqy --no-install-recommends install \
      fontconfig \
      fonts-noto-color-emoji \
      fonts-unifont \
      xfonts-cyrillic \
      xfonts-scalable \
      fonts-liberation \
      fonts-ipafont-gothic \
      fonts-wqy-zenhei \
      fonts-tlwg-loma-otf \
      fonts-freefont-ttf; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Build the two not-yet-packaged Xorg security fixes on the target architecture.
# Only signed APKs and their public key enter production; source checksums and
# upstream patch commits remain installed as package-owned provenance.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:256c88bb066424045021090932d50be93c8e3f2ce3586707702a401b146f3e43 AS x11-backports
RUN set -eux; \
    apk upgrade --no-cache; \
    apk add --no-cache \
      bash binutils coreutils gcc make pkgconf glibc-2.44-dev libxcrypt-dev \
      libxcb-dev libx11-dev xorgproto xtrans-dev util-macros-dev \
      curl patch gnutar gzip xz openssl-dev melange
COPY files/build-exporter-x11-backports.sh /tmp/build-exporter-x11-backports.sh
RUN bash /tmp/build-exporter-x11-backports.sh

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:256c88bb066424045021090932d50be93c8e3f2ce3586707702a401b146f3e43 AS runtime
LABEL maintainer="Penpot <docker@penpot.app>"

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/penpot/browsers

# Use one glibc distribution for Node, Chromium's native dependencies and
# ImageMagick. The exporter requires PNG/JPEG screenshots, PNG-to-WEBP/PPM
# conversion and pdfunite; it does not use the old artifact's EXR delegates
# or an X server (Playwright launches Chromium headlessly).
# Keep the APK database: dependency provenance must remain visible to scans.
COPY --from=x11-backports /out/penpot-exporter-backports.rsa.pub /etc/apk/keys/penpot-exporter-backports.rsa.pub
COPY --from=x11-backports /out/libx11-1.8.13-r100.apk /out/libxrender-0.9.12-r100.apk /tmp/x11-backports/
RUN set -eux; \
    apk upgrade --no-cache; \
    apk add --no-cache \
      /tmp/x11-backports/libx11-1.8.13-r100.apk \
      /tmp/x11-backports/libxrender-0.9.12-r100.apk \
      'glibc-2.44>=2.44-r8' \
      'nodejs-24-minimal>=24.21.0-r4' \
      'imagemagick-7>=7.1.2.33-r0' \
      'poppler-utils>=26.10.0-r0' \
      'libexpat1>=2.9.0-r0' \
      'libxml2-16>=2.15.4-r1' \
      'libmount>=2.42.4-r0' \
      'libblkid>=2.42.4-r0' \
      'tiff>=4.7.2-r3' \
      'libsystemd>=261.3-r5' \
      'ncurses>=6.6.20261010-r0' \
      tzdata \
      'glibc-2.44-locale-en>=2.44-r8' \
      ca-certificates-bundle \
      fontconfig \
      freetype \
      alsa-lib \
      libatk-bridge-2.0 \
      libatk-1.0 \
      at-spi2-core \
      cairo \
      'cups-libs>=2.4.19-r4' \
      dbus-libs \
      libdrm-libs \
      mesa-gbm \
      glib \
      libnspr \
      libnss \
      pango \
      libxcb \
      libxcomposite \
      libxdamage \
      libxext \
      libxfixes \
      libxkbcommon \
      libxrandr; \
    rm -rf /tmp/x11-backports; \
    addgroup -S -g 1001 penpot; \
    adduser -S -D -H -u 1001 -G penpot -h /opt/penpot -s /sbin/nologin penpot; \
    mkdir -p /opt/penpot; \
    chown penpot:penpot /opt/penpot

COPY --from=fonts /usr/share/fonts /usr/share/fonts
COPY --from=fonts /etc/fonts /etc/fonts
COPY --from=fonts /usr/share/fontconfig/conf.avail /usr/share/fontconfig/conf.avail
RUN fc-cache -f

# Dependency installation needs the full Node build image (including git for
# the pinned SVGO source), but none of its buildpack-deps belong in production.
FROM node:24.20.0-trixie@sha256:f7d34e58713740f9eef9092c0bd6ff10369d132f7238399a4b270f16d47fa608 AS build
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/penpot/browsers

ARG BUNDLE_PATH="./bundle-exporter/"
COPY $BUNDLE_PATH /opt/penpot/exporter/

WORKDIR /opt/penpot/exporter

# pnpm ships as a system binary (same tarball + SHA pin as
# docker/devenv/Dockerfile); the generated ./setup expects it on PATH.
# Corepack is gone from Node 25+, so nothing here may use it.
ARG PNPM_VERSION=12.5.1
RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "${ARCH}" in \
       aarch64|arm64) \
         PNPM_ARCH='arm64'; \
         PNPM_SHA256='84e1290e82c800acd406b6db27e9650e15db3c2344d12162cc305ea1f942c6ff'; \
         ;; \
       amd64|x86_64) \
         PNPM_ARCH='x64'; \
         PNPM_SHA256='5a397dfb6b3d4b07d3d7769586aeb471048faf04299a492e2808b95a9a1c701f'; \
         ;; \
       *) \
         echo "Unsupported arch: ${ARCH}"; \
         exit 1; \
         ;; \
    esac; \
    curl -LfsSo /tmp/pnpm.tar.gz "https://github.com/pnpm/pnpm/releases/download/v${PNPM_VERSION}/pnpm-linux-${PNPM_ARCH}.tar.gz"; \
    echo "${PNPM_SHA256} */tmp/pnpm.tar.gz" | sha256sum -c -; \
    mkdir -p /usr/local/bin; \
    tar -xzf /tmp/pnpm.tar.gz -C /usr/local/bin pnpm; \
    chmod 755 /usr/local/bin/pnpm; \
    rm -f /tmp/pnpm.tar.gz; \
    pnpm --version;

# `./setup` only needs pnpm on PATH (installed above as root).
RUN ./setup

FROM runtime AS image
COPY --from=build --chown=penpot:penpot /opt/penpot/exporter /opt/penpot/exporter
COPY --from=build --chown=penpot:penpot /opt/penpot/browsers /opt/penpot/browsers

WORKDIR /opt/penpot/exporter

USER penpot:penpot

CMD ["node", "app.js"]
